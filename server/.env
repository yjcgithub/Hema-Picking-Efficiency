# 本文件由 `npm start` 自动加载（node --env-file-if-exists=.env）
# 命令行里已有的同名环境变量优先，可临时覆盖本文件

# 服务端口：必须与 nginx proxy_pass 里的端口一致
PORT=3001

# 子路径前缀 /hpe
# 服务已做路径归一化，下面两种 nginx 写法都能正常工作，BASE_PATH 填 /hpe 或留空都可以：
#   location /hpe { proxy_pass http://127.0.0.1:3001;  }   （不剥前缀）
#   location /hpe { proxy_pass http://127.0.0.1:3001/; }   （剥掉前缀）
BASE_PATH=/hpe

# 跨域允许来源，默认 *；如需收紧改为前端域名
# ALLOW_ORIGIN=https://your-frontend.example.com

# 定时推送：服务端自绘图片（@resvg/resvg-js，无需浏览器）
# 中文字体：容器内缺中文字体时，装一个系统字体包（如 fonts-wqy-microhei），
# 或用下面两个变量指定字体文件 / 目录（多个用系统路径分隔符，Linux 为 :）。
# 注意：容器重启（1Panel 重建容器）会丢失运行时 apt 安装的字体，
# 建议把字体文件放进挂载卷（如 <CODE_DIR>/fonts/），再用 HEMA_SVG_FONT_FILE 指向容器内路径。
# HEMA_SVG_FONT_FILE=/app/fonts/wqy-microhei.ttc
# HEMA_SVG_FONT_DIR=/usr/share/fonts
# HEMA_SVG_FONT=WenQuanYi Micro Hei
# 出图倍率（默认 2，越大越清晰也越占内存）
# HEMA_SVG_SCALE=2

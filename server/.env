# 本文件由 `npm start` 自动加载（node --env-file-if-exists=.env）
# 命令行里已有的同名环境变量优先，可临时覆盖本文件

# 服务端口：必须与 nginx proxy_pass 里的端口一致
PORT=3001

# 子路径前缀 /hpe
# 服务已做路径归一化，下面两种 nginx 写法都能正常工作，BASE_PATH 填 /hpe 或留空都可以：
#   location /hpe { proxy_pass http://127.0.0.1:3001;  }   （不剥前缀）
#   location /hpe { proxy_pass http://127.0.0.1:3001/; }   （剥掉前缀）
BASE_PATH=/hpe

# 跨域允许来源，默认 *；如需收紧改为前端域名
# ALLOW_ORIGIN=https://your-frontend.example.com
